{
  "name": "krishnadas-portfolio",
  "version": "1.0.0",
  "description": "The backend for your personal portfolio is built to serve as a robust and scalable API that handles the management of content, user interactions, and other functionalities required for showcasing your work, skills, and projects. This backend is developed using modern technologies and follows best practices to ensure security, efficiency, and maintainability.",
  "main": "server.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "node dist/server.js",
    "dev": "nodemon",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.{ts,tsx}' --fix",
    "lint:check": "eslint 'src/**/*.{ts,tsx}'",
    "prettier": "prettier --write 'src/**/*.{ts,tsx}'",
    "prettier:check": "prettier --check 'src/**/*.{ts,tsx}'",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prebuild": "pnpm clean",
    "postbuild": "echo 'Build completed successfully'",
    "docker:build": "docker build -t portfolio-backend .",
    "docker:run": "docker run -p 5000:5000 portfolio-backend",
    "docker:compose": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs portfolio-backend",
    "pm2:monit": "pm2 monit",
    "deploy:production": "pm2 deploy production",
    "deploy:staging": "pm2 deploy staging",
    "health": "curl -f http://localhost:5000/health || exit 1",
    "metrics": "curl -f http://localhost:5000/metrics || exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krishnadas-N/Personal-Portfolio-Backend.git"
  },
  "keywords": [
    "Node.js",
    "Express.js",
    "JavaScript",
