{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": "./",
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
 "include": ["src/**/*.ts", "src/types/**/*.d.ts","tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
